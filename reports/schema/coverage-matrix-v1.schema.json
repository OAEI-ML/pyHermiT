{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oaei-ml.github.io/pyhermit/schema/coverage-matrix-v1.json",
  "title": "pyHermiT public coverage matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_on",
    "revision",
    "constructor_contract",
    "operation_groups",
    "high_risk_interactions"
  ],
  "properties": {
    "schema": {"const": "pyhermit.coverage-matrix/1"},
    "generated_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "constructor_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "count", "positive", "negative", "interaction", "status"],
      "properties": {
        "source": {"const": "pyowl_core.MODEL_CONSTRUCTORS"},
        "count": {"type": "integer", "minimum": 1},
        "positive": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "negative": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "interaction": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "status": {"enum": ["pass", "blocked", "fail"]}
      }
    },
    "operation_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "members", "positive", "negative", "interaction", "backends", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "members": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "positive": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "negative": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "interaction": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "backends": {
            "type": "array",
            "minItems": 4,
            "items": {"enum": ["python", "native", "auto", "verify"]}
          },
          "status": {"enum": ["pass", "blocked", "fail"]}
        }
      }
    },
    "high_risk_interactions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "status": {"enum": ["pass", "blocked", "fail"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
