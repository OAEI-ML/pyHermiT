{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oaei-ml.github.io/pyhermit/schema/release-report-v1.json",
  "title": "pyHermiT release audit report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_on",
    "revision",
    "package_version",
    "overall_status",
    "suites",
    "backend_matrix",
    "artifacts",
    "external_gates"
  ],
  "properties": {
    "schema": {"const": "pyhermit.release-report/1"},
    "generated_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "package_version": {"type": "string", "minLength": 1},
    "overall_status": {"enum": ["pass", "blocked", "fail"]},
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    },
    "backend_matrix": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["backend", "status", "evidence"],
        "properties": {
          "backend": {"enum": ["python", "native", "auto", "verify"]},
          "status": {"enum": ["pass", "blocked", "fail"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "filename", "sha256", "source_revision", "status", "evidence"],
        "properties": {
          "kind": {"enum": ["native-wheel", "pure-wheel", "sdist"]},
          "filename": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_revision": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
          "status": {"enum": ["pass", "blocked", "fail"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "external_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "reason", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
          "status": {"enum": ["pass", "blocked", "fail"]},
          "reason": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runtime", "backend", "status", "tests", "subtests", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1},
        "backend": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "blocked", "fail"]},
        "tests": {"type": "integer", "minimum": 0},
        "subtests": {"type": "integer", "minimum": 0},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
