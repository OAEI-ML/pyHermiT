{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oaei-ml.org/pyhermit/reference/request-v1.schema.json",
  "title": "pyHermiT reference oracle request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "operation", "input", "config", "limits"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "operation": {"enum": ["identity", "consistency", "class_hierarchy", "normalization"]},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "sha256", "imports"],
      "properties": {
        "document": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "imports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["logical_iri", "document", "sha256"],
            "properties": {
              "logical_iri": {"type": "string", "minLength": 1},
              "document": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ignore_unsupported_datatypes"],
      "properties": {"ignore_unsupported_datatypes": {"type": "boolean"}}
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "memory_mb"],
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "memory_mb": {"type": "integer", "minimum": 128, "maximum": 32768}
      }
    }
  }
}
