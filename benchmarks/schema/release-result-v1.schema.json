{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oaei-ml.github.io/pyhermit/schema/benchmark-release-result-v1.json",
  "title": "pyHermiT phase benchmark result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "environment",
    "workload",
    "backend",
    "input_sha256",
    "result_sha256",
    "samples",
    "medians",
    "peak_python_bytes",
    "peak_rss_bytes"
  ],
  "properties": {
    "schema": {"const": "pyhermit.release-benchmark/1"},
    "status": {"enum": ["informational-local", "accepted-dedicated"]},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "implementation", "platform", "machine", "processor"],
      "properties": {
        "python": {"type": "string"},
        "implementation": {"type": "string"},
        "platform": {"type": "string"},
        "machine": {"type": "string"},
        "processor": {"type": "string"}
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "size", "classes", "individuals", "seed"],
      "properties": {
        "family": {"const": "generated-taxonomy"},
        "size": {"enum": ["small", "medium", "large"]},
        "classes": {"type": "integer", "minimum": 1},
        "individuals": {"type": "integer", "minimum": 0},
        "seed": {"const": 1729}
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "selected", "accelerated", "implementation_version"],
      "properties": {
        "requested": {"enum": ["python", "native", "verify"]},
        "selected": {"enum": ["python", "native", "verify"]},
        "accelerated": {"type": "boolean"},
        "implementation_version": {"type": "string", "minLength": 1}
      }
    },
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["load_seconds", "compile_seconds", "consistency_seconds", "classification_seconds", "realization_seconds"],
        "properties": {
          "load_seconds": {"type": "number", "minimum": 0},
          "compile_seconds": {"type": "number", "minimum": 0},
          "consistency_seconds": {"type": "number", "minimum": 0},
          "classification_seconds": {"type": "number", "minimum": 0},
          "realization_seconds": {"type": "number", "minimum": 0}
        }
      }
    },
    "medians": {
      "type": "object",
      "additionalProperties": false,
      "required": ["load_seconds", "compile_seconds", "consistency_seconds", "classification_seconds", "realization_seconds"],
      "properties": {
        "load_seconds": {"type": "number", "minimum": 0},
        "compile_seconds": {"type": "number", "minimum": 0},
        "consistency_seconds": {"type": "number", "minimum": 0},
        "classification_seconds": {"type": "number", "minimum": 0},
        "realization_seconds": {"type": "number", "minimum": 0}
      }
    },
    "peak_python_bytes": {"type": "integer", "minimum": 0},
    "peak_rss_bytes": {"type": ["integer", "null"], "minimum": 0}
  }
}
