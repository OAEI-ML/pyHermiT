include README.md
include LICENSE
include COPYING
include NOTICE.md
include pyproject.toml
include setup.py
include Cargo.toml
recursive-include src *.py *.pyi py.typed
recursive-include specs *.md *.toml
recursive-include tools/specs *.py *.toml *.md
prune tools/packaging_probe
prune .github
global-exclude *.py[cod]
global-exclude *.jar
global-exclude *.class
global-exclude *.java
global-exclude __pycache__
global-exclude .DS_Store
